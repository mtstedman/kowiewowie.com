  "changes": [
    {
      "scope": "owned UxROM engine",
      "behavior": "Private fixed-three JS/Wasm fast path plus narrow pattern/palette/nametable uploads into owned storage. Retains register timing, custom callback fallbacks, partial errors and clock fences."
    },
    {
      "scope": "MMC3-dot, timed MMC3, MMC5",
      "behavior": "Publish position at public advances, host effects and observers; private machine clocks avoid redundant publication. Initialize both native and JS fallback clocks on every install/reset."
    },
    {
      "scope": "shared native source pipeline",
      "behavior": "MMC3/MMC5 now compile from one common source and compiler recipe, with compile-time mapper behavior. Consolidation alone reproduces both previous Wasm binaries byte for byte; no speed claim for that consolidation."
    }
  ],
