# Copy to .env for local development, or install as
# /etc/wowiekowie.com/api.env in production (root:www-data, mode 0640).
WOWIE_DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=wowiekowie"
WOWIE_DB_USER="wowiekowie_app"
WOWIE_DB_PASSWORD="replace-with-a-generated-database-password"
WOWIE_JWT_SECRET="base64:replace-with-at-least-32-random-bytes-in-base64"
WOWIE_JWT_ISSUER="https://api.wowiekowie.com"
WOWIE_JWT_AUDIENCE="wowiekowie.com"
WOWIE_ACCESS_TOKEN_TTL="900"
WOWIE_REFRESH_TOKEN_TTL="2592000"
WOWIE_REGISTRATION_ENABLED="false"
WOWIE_API_BASE_URL="https://api.wowiekowie.com"
WOWIE_CORS_ORIGINS="https://wowiekowie.com,https://www.wowiekowie.com"
WOWIE_DEBUG="false"

# Optional OAuth providers. The callback URLs are:
# https://api.wowiekowie.com/v1/auth/oauth/google/callback
# https://api.wowiekowie.com/v1/auth/oauth/github/callback
WOWIE_OAUTH_GOOGLE_CLIENT_ID=""
WOWIE_OAUTH_GOOGLE_CLIENT_SECRET=""
WOWIE_OAUTH_GITHUB_CLIENT_ID=""
WOWIE_OAUTH_GITHUB_CLIENT_SECRET=""

